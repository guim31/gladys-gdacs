      "type": "boolean",
      "label": {
        "en": "Red alerts of the whole world",
        "fr": "Alertes rouges du monde entier",
        "de": "Rote Warnungen der ganzen Welt",
        "es": "Alertas rojas de todo el mundo"
      },
      "description": {
        "en": "Also follow every red alert, wherever it is: family abroad, travels.",
        "fr": "Suivre aussi toutes les alertes rouges, où qu'elles soient : famille à l'étranger, voyages.",
        "de": "Verfolge auch jede rote Warnung, wo auch immer: Familie im Ausland, Reisen.",
        "es": "Seguir también todas las alertas rojas, estén donde estén: familia en el extranjero, viajes."
      },
      "required": false,
      "default": false
    },

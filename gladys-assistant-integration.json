      "label": {
        "en": "Minimum alert level",
        "fr": "Niveau d'alerte minimal",
        "de": "Mindestwarnstufe",
        "es": "Nivel de alerta mínimo"
      },
      "description": {
        "en": "Green: minor event, no international help expected. Orange: help may be needed. Red: major disaster.",
        "fr": "Vert : événement limité, sans aide internationale attendue. Orange : une aide peut être nécessaire. Rouge : catastrophe majeure.",
        "de": "Grün: begrenztes Ereignis, keine internationale Hilfe erwartet. Orange: Hilfe kann nötig sein. Rot: schwere Katastrophe.",
        "es": "Verde: evento limitado, sin ayuda internacional prevista. Naranja: puede necesitarse ayuda. Rojo: catástrofe grave."
      },
      "required": false,
      "default": "green",
      "options": [
        {
          "value": "green",
          "label": {
            "en": "Green",
            "fr": "Vert",
            "de": "Grün",
            "es": "Verde"
          }
        },
        {
          "value": "orange",
          "label": {
            "en": "Orange",
            "fr": "Orange",
